rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploads: owner-only write, capped at 500 MB, audio-ish content types.
    match /uploads/{uid}/{sessionId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 500 * 1024 * 1024;
    }
    // Results: written only by Cloud Functions (admin), readable by owner.
    match /results/{uid}/{sessionId}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
