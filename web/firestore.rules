rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sessions: owner-only. Clients create the doc (queued) and read their
    // own; only Cloud Functions (admin SDK, bypasses rules) may write
    // status/metrics/resultPath.
    match /sessions/{sessionId} {
      allow read: if request.auth != null
                  && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.status == "queued";
      // clients may edit their own display metadata, never analysis fields
      allow update: if request.auth != null
                    && resource.data.owner == request.auth.uid
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly(["performer", "venue", "date", "title"]);
      allow delete: if request.auth != null
                    && resource.data.owner == request.auth.uid;
    }
  }
}
